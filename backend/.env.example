# MongoDB Connection URI (Replace with your MongoDB Atlas or Local MongoDB link)
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/nhaa_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nhaa_db

# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_here

# Optional MySQL Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=nhaa_db
